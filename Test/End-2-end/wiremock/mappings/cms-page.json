{
  "mappings": [
    {
      "name": "CMS page - turn 2, summary after the tool ran",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/v1/messages",
        "bodyPatterns": [
          {"contains": "E2E WireMock check"},
          {"contains": "tool_result"}
        ]
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "text/event-stream"},
        "bodyFileName": "cms-page-summary.sse",
        "chunkedDribbleDelay": {"numberOfChunks": 20, "totalDuration": 200}
      }
    },
    {
      "name": "CMS page - turn 1, ask to create the page",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/v1/messages",
        "bodyPatterns": [
          {"contains": "E2E WireMock check"},
          {"doesNotMatch": ".*tool_result.*"}
        ]
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "text/event-stream"},
        "bodyFileName": "cms-page-tool-call.sse",
        "chunkedDribbleDelay": {"numberOfChunks": 25, "totalDuration": 250}
      }
    }
  ]
}
