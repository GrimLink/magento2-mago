    --maggy-accent: <?= $accentColor ?>;
    --maggy-accent-hover: <?= $accentColorHover ?>;
    --maggy-accent-light: <?= $accentColorLight ?>;
    --maggy-accent-rgb: <?= $accentRgb ?>;
    --maggy-accent-text: <?= $accentText ?>;
    --maggy-panel-width: 360px;
}
</style>

