<?php
/** @var \MaggyAssistant\Base\Block\Adminhtml\ChatPanel $block */
/** @var \Magento\Framework\Escaper $escaper */
if (!$block->isVisible()) {
    return;
}
$accentColorRaw = $block->getAccentColor();
$textColorRaw = $block->getTextColor();
// Sanitize: only allow valid hex colors
$accentColor = preg_match('/^#[0-9a-fA-F]{6}$/', $accentColorRaw) ? $accentColorRaw : '#F26322';
$accentText = preg_match('/^#[0-9a-fA-F]{6}$/', $textColorRaw) ? $textColorRaw : '#FFFFFF';
// Compute derived colors from accent
$hex = ltrim($accentColor, '#');
$r = hexdec(substr($hex, 0, 2));
$g = hexdec(substr($hex, 2, 2));
$b = hexdec(substr($hex, 4, 2));
$accentColorLight = sprintf('#%02x%02x%02x', (int)(255 - (255 - $r) * 0.15), (int)(255 - (255 - $g) * 0.15), (int)(255 - (255 - $b) * 0.15));
$accentRgb = "$r,$g,$b";
// Hover: lighten dark colors, darken light colors
$luminance = 0.2126 * ($r / 255) + 0.7152 * ($g / 255) + 0.0722 * ($b / 255);
if ($luminance < 0.3) {
    $accentColorHover = sprintf('#%02x%02x%02x', min(255, (int)($r + (255 - $r) * 0.25)), min(255, (int)($g + (255 - $g) * 0.25)), min(255, (int)($b + (255 - $b) * 0.25)));
} else {
    $accentColorHover = sprintf('#%02x%02x%02x', (int)($r * 0.8), (int)($g * 0.8), (int)($b * 0.8));
}
?>

<style>
:root {
    --maggy-accent: <?= $accentColor ?>;
    --maggy-accent-hover: <?= $accentColorHover ?>;
    --maggy-accent-light: <?= $accentColorLight ?>;
    --maggy-accent-rgb: <?= $accentRgb ?>;
    --maggy-accent-text: <?= $accentText ?>;
    --maggy-panel-width: 360px;

    /* Mago brand palette — see brand-guidelines.md */
    --mago-sunset: #FF7A33;
    --mago-deep: #E65000;
    --mago-obsidian: #2A2624;
    --mago-void: #373330;

    /* Light panel surfaces. Obsidian carries the brand as ink rather than
       background; the neutrals are warm so they stay in the brand family. */
    --mago-panel: #FFFFFF;
    --mago-surface: #F6F3F0;
    --mago-hairline: rgba(42, 38, 36, 0.10);
    --mago-ink: #2A2624;
    --mago-ink-muted: #8A817B;

    /* Inter ships self-hosted with the admin theme and Open Sans with stock
       Magento, so this stack loads nothing extra on either. */
    --mago-font: 'Inter', 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --mago-tracking: -0.02em;
}
</style>

