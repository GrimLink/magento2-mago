    --maggy-accent-hover: <?= /* @noEscape */ $accentColorHover ?>;
    --maggy-accent-light: <?= /* @noEscape */ $accentColorLight ?>;
    --maggy-accent-rgb: <?= /* @noEscape */ $accentRgb ?>;
    --maggy-accent-text: <?= /* @noEscape */ $accentText ?>;
    --maggy-panel-width: 440px;

    /* Mago brand palette — see brand-guidelines.md */
    --mago-sunset: #FF7A33;
    --mago-deep: #E65000;
    --mago-obsidian: #2A2624;
    --mago-void: #373330;
    --mago-tint: #FFE9DC;

    /* Light panel surfaces: white panel, warm hairlines, Void as ink. The
       accent only appears as the mark, the user's bubble, links and the
       active step — everything else is neutral chrome. */
    --mago-panel: #FFFFFF;
    --mago-surface: #F7F5F3;
    --mago-hairline: #E9E5E1;
    --mago-ink: #373330;
