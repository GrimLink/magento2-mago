<?php
/** @var \MagoAssistant\Mago\Block\Adminhtml\ChatPanel $block */
/** @var \Magento\Framework\Escaper $escaper */
if (!$block->isVisible()) {
    return;
}
// The button doubles as the close affordance once the panel is open, so the
// label, the aria state and the active style all flip together in chat-panel.js.
$labelOpen = __('Open %1', $block->getAssistantName());
$labelClose = __('Close %1', $block->getAssistantName());
?>
<button type="button" id="mago-toggle" class="mago-header-icon"
        title="<?= $escaper->escapeHtmlAttr($labelOpen) ?>"
        aria-expanded="false"
        aria-controls="mago-chat"
        data-label-open="<?= $escaper->escapeHtmlAttr($labelOpen) ?>"
        data-label-close="<?= $escaper->escapeHtmlAttr($labelClose) ?>">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="34 30 188 188" fill="currentColor" aria-hidden="true">
        <polygon points="128,40 160,72 128,104 96,72" opacity="0.55"/>
        <polygon points="44,208 96,104 128,136 160,104 212,208 152,208 128,160 104,208"/>
    </svg>
</button>
