<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="MaggyAssistant_Base::config" title="Admin Assistant Configuration" sortOrder="10"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="MaggyAssistant_Base::assistant" title="Admin Assistant" sortOrder="100">
                    <resource id="MaggyAssistant_Base::assistant_read" title="Read Operations" sortOrder="10"/>
                    <resource id="MaggyAssistant_Base::assistant_write" title="Write Operations" sortOrder="20"/>
                    <resource id="MaggyAssistant_Base::conversations" title="Manage Conversations" sortOrder="30">
                        <resource id="MaggyAssistant_Base::conversations_delete" title="Delete Conversations" sortOrder="10"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
